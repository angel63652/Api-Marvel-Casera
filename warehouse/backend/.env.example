# ---- Base de datos ----
# Producción (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/warehouse_db
# Desarrollo rápido (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./wms.db

# ---- Seguridad ----
SECRET_KEY=cambia-esta-clave-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- IA (clasificación de correos) ----
ANTHROPIC_API_KEY=

# ---- Gmail / Google Workspace OAuth ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/emails/oauth-callback

# ---- App ----
APP_NAME=WMS Almacén
DEBUG=True
