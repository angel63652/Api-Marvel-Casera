# Copia este archivo a .env y rellena los valores. NUNCA subas tu .env real.

# ---- Base de datos ----
# Desarrollo rápido (SQLite) — es el valor por defecto si no defines nada:
DATABASE_URL=sqlite+aiosqlite:///./wms.db
# Producción (PostgreSQL) — usa credenciales reales, no estas de ejemplo:
# DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:5432/warehouse_db

# ---- Seguridad ----
# OBLIGATORIO en producción. Genera una clave fuerte:  openssl rand -hex 32
# Si lo dejas vacío y DEBUG=True, se genera una efímera solo para desarrollo.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes permitidos para CORS (lista JSON). NUNCA uses "*" en producción.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ---- Admin bootstrap ----
# En producción el admin solo se crea si defines ADMIN_PASSWORD.
ADMIN_EMAIL=admin@distrigal.com
ADMIN_PASSWORD=

# ---- Docker Compose (PostgreSQL) ----
# Requeridos por docker-compose.yml (falla si faltan):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=warehouse_db

# ---- IA (clasificación de correos) ----
ANTHROPIC_API_KEY=

# ---- Gmail / Google Workspace OAuth ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/emails/oauth-callback

# ---- App ----
APP_NAME=WMS Almacén
# Producción: False. Desarrollo: True.
DEBUG=False
